---
interface Props {
  featuredProjects: import("../data/site-types").FeaturedProject[];
}

const { featuredProjects } = Astro.props;
---

<section class="panel" aria-labelledby="projects-title">
  <div class="section-head">
    <h2 id="projects-title">Featured products</h2>
    <p>
      Live product evidence from the places where the work is actually
      happening: repos, launch surfaces, docs, and systems that can keep growing
      into paid tools.
    </p>
  </div>

  <div class="featured-grid">
    {
      featuredProjects.map((project) => (
        <article class={`featured-card ${project.accent}`}>
          <div class="featured-visual" aria-hidden="true">
            {project.icon && (
              <img
                src={project.icon}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                class="featured-icon"
              />
            )}
            <span class="featured-label">{project.visual}</span>
          </div>
          <div class="featured-copy">
            <p class="status-tag">{project.status}</p>
            <h3>
              <a href={project.href} target="_blank" rel="noreferrer">
                {project.name}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="external-arrow"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </a>
            </h3>
            <p>{project.summary}</p>
            <ul class="mini-list">
              {project.highlights.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
