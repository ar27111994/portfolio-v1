---
interface Props {
  labNotes: import("../data/site-types").LabNote[];
}

const { labNotes } = Astro.props;

const accentColors = ["accent-blue", "accent-orange", "accent-green", "accent-violet"];
---

<section class="panel lab-panel" aria-labelledby="lab-title">
  <div class="section-head">
    <h2 id="lab-title">Developer lab</h2>
    <p>
      A focused bench for tools, systems, proof surfaces, and selective client
      work — practical experiments that can become reliable products.
    </p>
  </div>
  <div class="lab-grid">
    {
      labNotes.map((item, i) => (
        <article class={`lab-card-premium ${accentColors[i % 4]}`}>
          <div class="lab-card-icon" aria-hidden="true">
            {item.icon || "🔬"}
          </div>
          <div class="lab-card-body">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
          <div class="lab-card-glow" aria-hidden="true"></div>
        </article>
      ))
    }
  </div>
</section>
