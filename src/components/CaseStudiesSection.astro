---
interface Props {
  caseStudies: import("../data/site-types").CaseStudy[];
}

const { caseStudies } = Astro.props;
---

<section class="panel" aria-labelledby="case-studies">
  <div class="section-head">
    <h2 id="case-studies">Case studies</h2>
    <p>
      Problem → approach → measurable outcome. Four representative projects
      across enterprise, solo POC, founder, and OSS work.
    </p>
  </div>

  <div class="case-studies-carousel swiper" id="case-studies-swiper">
    <div class="swiper-wrapper">
      {
        caseStudies.map((cs) => (
          <div class="swiper-slide">
            <article class="case-study-card">
              <h3>
                {cs.icon && (
                  <img
                    src={cs.icon}
                    alt=""
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                    class="cs-title-icon"
                  />
                )}
                {cs.title}
              </h3>
              <p class="cs-context">{cs.context}</p>
              <div class="cs-body">
                <div class="cs-block">
                  <strong class="cs-label">Problem</strong>
                  <p>{cs.problem}</p>
                </div>
                <div class="cs-block">
                  <strong class="cs-label">Approach</strong>
                  <p>{cs.approach}</p>
                </div>
                <div class="cs-block">
                  <strong class="cs-label">Outcome</strong>
                  <p>{cs.outcome}</p>
                </div>
              </div>
              <div class="cs-footer">
                <div class="cs-tech">
                  {cs.tech.map((t) => (
                    <span class="cs-tag">{t}</span>
                  ))}
                </div>
                <ul class="cs-metrics">
                  {cs.metrics.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
            </article>
          </div>
        ))
      }
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>
