---
interface Props {
  contactEmail: string;
  certificationLinks: import("../data/site-types").CertificationLink[];
  ventureProof: import("../data/site-types").VentureProof[];
  openSourceFreemium: import("../data/site-types").OpenSourceItem[];
}

const { contactEmail, certificationLinks, ventureProof, openSourceFreemium } =
  Astro.props;
---

<section class="panel" aria-labelledby="proof-title">
  <div class="section-head">
    <h2 id="proof-title">Proof links: certifications, venture, OSS/freemium</h2>
    <p>
      Verifiable background signals: certifications, partner identity, older
      shipped projects, and founder/operator work that still supports the
      current devtools and automation direction.
    </p>
  </div>

  <div class="proof-grid">
    <article class="resource-card">
      <h3>Certifications / partner track</h3>
      <ul class="cert-list">
        <li class="cert-item cert-partner">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/anthropic.svg"
              alt="Anthropic"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">Anthropic Developer</strong>
            <span class="cert-meta"
              >Claude Partner Network — 4 certifications</span
            >
          </div>
        </li>
        <li class="cert-item cert-partner">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/microsoft.svg"
              alt="Microsoft"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">Microsoft Developer</strong>
            <span class="cert-meta">associated with {contactEmail}</span>
          </div>
        </li>
        <li class="cert-item">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/nvidia.svg"
              alt="NVIDIA"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">NVIDIA Developer Program</strong>
            <span class="cert-meta">GPU computing, CUDA, AI inference</span>
          </div>
        </li>
        <li class="cert-item">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/amd.svg"
              alt="AMD"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">AMD Developer Program</strong>
            <span class="cert-meta">ROCm, heterogeneous computing</span>
          </div>
        </li>
        <li class="cert-item">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/aws.svg"
              alt="AWS"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">AWS Developer Program</strong>
            <span class="cert-meta"
              >Cloud infrastructure, serverless, AI services</span
            >
          </div>
        </li>
        <li class="cert-item">
          <span class="cert-icon-wrap">
            <img
              src="/brand-icons/googlecloud.svg"
              alt="Google Cloud"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              class="cert-icon"
            />
          </span>
          <div class="cert-body">
            <strong class="cert-name">Google Developer Program</strong>
            <span class="cert-meta">Cloud, AI platform, Gemini ecosystem</span>
          </div>
        </li>
        {
          certificationLinks
            .filter((item) => item.issuer === "Anthropic")
            .map((item) => (
              <li class="cert-item">
                <span class="cert-icon-wrap">
                  <img
                    src={item.icon}
                    alt={item.issuer}
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                    class="cert-icon"
                  />
                </span>
                <div class="cert-body">
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                    class="cert-link"
                  >
                    {item.label}
                  </a>
                  {item.pdf && (
                    <a
                      href={item.pdf}
                      target="_blank"
                      rel="noreferrer"
                      class="cert-pdf"
                      aria-label={`Download PDF for ${item.label}`}
                    >
                      PDF ↓
                    </a>
                  )}
                </div>
              </li>
            ))
        }
        {
          certificationLinks
            .filter((item) => item.issuer !== "Anthropic")
            .map((item) => (
              <li class="cert-item">
                <span class="cert-icon-wrap">
                  <img
                    src={item.icon}
                    alt={item.issuer}
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                    class="cert-icon"
                  />
                </span>
                <div class="cert-body">
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                    class="cert-link"
                  >
                    {item.label}
                  </a>
                </div>
              </li>
            ))
        }
      </ul>
    </article>

    <article class="resource-card">
      <h3>Goggle Hunt / Flippa / Gleam</h3>
      <ul class="cert-list">
        {
          ventureProof.map((item) => (
            <li class="cert-item">
              {item.icon ? (
                <span class="cert-icon-wrap">
                  <img
                    src={item.icon}
                    alt=""
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                    class="cert-icon"
                  />
                </span>
              ) : (
                <span
                  class="cert-icon-wrap cert-icon-empty"
                  aria-hidden="true"
                />
              )}
              <div class="cert-body">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer"
                  class="cert-link"
                >
                  {item.label}
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 style="margin-top:1.2rem">Open-source / freemium work</h3>
      <ul class="multi-col oss-icon-list">
        {
          openSourceFreemium.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noreferrer">
                {item.icon && (
                  <img
                    src={item.icon}
                    alt=""
                    width="16"
                    height="16"
                    loading="lazy"
                    decoding="async"
                    class="oss-icon"
                  />
                )}
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
