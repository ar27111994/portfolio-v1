---
interface Props {
  additionalProjects: import("../data/site-types").AdditionalProject[];
}

const { additionalProjects } = Astro.props;
---

<section class="panel" aria-labelledby="threads">
  <div class="section-head">
    <h2 id="threads">Product and tooling threads</h2>
    <p>
      Supporting work that shows range beyond the headline tools: visual
      systems, challenge builds, mobile context products, and data-quality
      workflows.
    </p>
  </div>
  <div class="threads-grid">
    {
      additionalProjects.map((project) => (
        <article class={`thread-card thread-${project.accent || "default"}`}>
          <div class="thread-visual" aria-hidden="true">
            {project.icon && (
              <img
                src={project.icon}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
                class="thread-icon"
              />
            )}
            <span class="thread-accent-dot"></span>
          </div>
          <div class="thread-copy">
            <h3>
              <a href={project.href} target="_blank" rel="noreferrer">
                {project.name}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="external-arrow"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              </a>
            </h3>
            <p>{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
