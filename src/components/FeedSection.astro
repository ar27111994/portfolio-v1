---
interface Props {
  feedSources: import("../data/site-types").FeedSource[];
  writingLinks: import("../data/site-types").WritingLink[];
}

const { feedSources } = Astro.props;
---

<section class="panel" aria-labelledby="feed-title">
  <div class="section-head split-head">
    <div>
      <h2 id="feed-title">Public work feed</h2>
      <p>
        Live content pulled from dev.to, GitHub, and Hacker News APIs on page
        load. Falls back gracefully when APIs are rate-limited or blocked.
      </p>
    </div>
    <a
      class="button primary small"
      href="https://dev.to/ar27111994"
      target="_blank"
      rel="noreferrer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      Open Dev.to
    </a>
  </div>

  <!-- Fully dynamic live feed -->
  <div class="feed-live-widget" data-feed-widget>
    <div class="feed-live-status" data-feed-status>Loading public feed items…</div>
    <div class="feed-live-list" data-feed-list></div>
  </div>

  <!-- Feed sources -->
  <details class="feed-sources-details">
    <summary>Feed sources ({feedSources.length})</summary>
    <div class="feed-sources-grid">
      {
        feedSources.map((source) => (
          <a
            class="feed-source-pill"
            href={source.href}
            target="_blank"
            rel="noreferrer"
          >
            <img
              src={source.icon}
              alt=""
              width="18"
              height="18"
              loading="lazy"
              decoding="async"
            />
            <span>{source.label}</span>
            <small>{source.type}</small>
          </a>
        ))
      }
    </div>
  </details>
</section>
