---
interface Props {
  testimonials: import("../data/site-types").Testimonial[];
}

const { testimonials } = Astro.props;
---

<section class="panel testimonials-panel" aria-labelledby="testimonials">
  <div class="section-head">
    <h2 id="testimonials">What clients & colleagues say</h2>
    <p>
      Endorsements from LinkedIn and Upwork across enterprise, freelance, and
      team-collaboration engagements.
    </p>
  </div>

  <div class="testimonials-carousel swiper" id="testimonials-swiper">
    <div class="swiper-wrapper">
      {
        testimonials.map((t) => (
          <div class="swiper-slide">
            <blockquote class="testimonial-card">
              <p class="testimonial-quote">"{t.quote}"</p>
              <footer class="testimonial-footer">
                <cite>
                  <strong>{t.author}</strong>
                  <span class="testimonial-role">{t.role}</span>
                  <span class="testimonial-context">{t.relation}</span>
                </cite>
                <a
                  href={t.href}
                  target="_blank"
                  rel="noreferrer"
                  class="testimonial-source"
                >
                  <img
                    src={`/brand-icons/${t.platform.toLowerCase()}.svg`}
                    alt=""
                    width="14"
                    height="14"
                    loading="lazy"
                    decoding="async"
                    class="testimonial-source-icon"
                  />
                  {t.platform}
                </a>
              </footer>
            </blockquote>
          </div>
        ))
      }
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>
