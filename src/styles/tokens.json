{
  "$schema": "https://tr.designtokens.org/2025-10/specification/design-token.schema.json",
  "color": {
    "palette": {
      "ink": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.051, 0.043] },
        "$type": "color",
        "$description": "Primary text"
      },
      "ink-soft": {
        "$value": { "colorSpace": "srgb", "components": [0.176, 0.157, 0.141] },
        "$type": "color"
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.361, 0.322, 0.282] },
        "$type": "color",
        "$description": "Secondary text. Dark: #a89d8e → 7.1:1 AAA"
      },
      "paper": {
        "$value": { "colorSpace": "srgb", "components": [0.98, 0.969, 0.949] },
        "$type": "color",
        "$description": "Page canvas. Dark: #14110d (warm cardstock)"
      },
      "paper-2": {
        "$value": { "colorSpace": "srgb", "components": [0.996, 0.988, 0.973] },
        "$type": "color"
      },
      "card": {
        "$value": { "colorSpace": "srgb", "components": [0.996, 0.992, 0.98] },
        "$type": "color",
        "$description": "Card / elevated surface"
      },
      "line": {
        "$value": { "colorSpace": "srgb", "components": [0.831, 0.784, 0.706] },
        "$type": "color",
        "$description": "Subtle borders"
      },
      "line-dark": {
        "$value": { "colorSpace": "srgb", "components": [0.18, 0.165, 0.149] },
        "$type": "color"
      },
      "surface": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
        "$type": "color",
        "$description": "White surface"
      },
      "surface-inverse": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.051, 0.043] },
        "$type": "color",
        "$description": "Always-dark surface"
      },
      "blue": {
        "$value": { "colorSpace": "srgb", "components": [0.102, 0.302, 1] },
        "$type": "color",
        "$description": "Link color. Dark: #6b94ff → 7.2:1 AAA on page"
      },
      "green": {
        "$value": { "colorSpace": "srgb", "components": [0.043, 0.478, 0.29] },
        "$type": "color"
      },
      "orange": {
        "$value": { "colorSpace": "srgb", "components": [0.831, 0.29, 0.102] },
        "$type": "color"
      },
      "violet": {
        "$value": { "colorSpace": "srgb", "components": [0.486, 0.227, 0.929] },
        "$type": "color"
      },
      "brand-accent": {
        "$value": { "colorSpace": "srgb", "components": [0.792, 1, 0.502] },
        "$type": "color",
        "$description": "Brand green accent — never changes with theme"
      }
    },
    "semantic": {
      "text": {
        "primary": { "$value": "{color.palette.ink}", "$type": "color" },
        "secondary": { "$value": "{color.palette.ink-soft}", "$type": "color" },
        "muted": { "$value": "{color.palette.muted}", "$type": "color" },
        "inverse": {
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
          "$type": "color",
          "$description": "Text on dark surfaces"
        }
      },
      "surface": {
        "canvas": { "$value": "{color.palette.paper}", "$type": "color" },
        "card": { "$value": "{color.palette.card}", "$type": "color" },
        "glass": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.996, 0.988, 0.973],
            "alpha": 0.85
          },
          "$type": "color",
          "$description": "Glass panel background"
        },
        "inverse": {
          "$value": "{color.palette.surface-inverse}",
          "$type": "color"
        }
      },
      "border": {
        "subtle": { "$value": "{color.palette.line}", "$type": "color" }
      },
      "action": {
        "primary": { "$value": "{color.palette.blue}", "$type": "color" },
        "accent": { "$value": "{color.palette.brand-accent}", "$type": "color" }
      }
    },
    "component": {
      "button": {
        "primary": {
          "bg": { "$value": "{color.palette.blue}", "$type": "color" },
          "text": {
            "$value": "{color.semantic.text.inverse}",
            "$type": "color"
          }
        },
        "accent": {
          "bg": { "$value": "{color.palette.brand-accent}", "$type": "color" },
          "text": {
            "$value": "{color.palette.surface-inverse}",
            "$type": "color"
          }
        },
        "inverse": {
          "bg": {
            "$value": "{color.palette.surface-inverse}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.semantic.text.inverse}",
            "$type": "color"
          }
        }
      },
      "card": {
        "bg": { "$value": "{color.palette.card}", "$type": "color" },
        "border": { "$value": "{color.palette.line}", "$type": "color" }
      },
      "tag": {
        "bg": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.969, 0.788] },
          "$type": "color"
        },
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.318, 0.286, 0.255]
          },
          "$type": "color"
        }
      },
      "pill": {
        "inverse": {
          "bg": {
            "$value": "{color.palette.surface-inverse}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.semantic.text.inverse}",
            "$type": "color"
          }
        }
      },
      "glass": {
        "panel": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.996, 0.988, 0.973],
            "alpha": 0.85
          },
          "$type": "color"
        },
        "topbar": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.98, 0.969, 0.949],
            "alpha": 0.82
          },
          "$type": "color"
        },
        "nav": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.996, 0.988, 0.973],
            "alpha": 0.82
          },
          "$type": "color"
        }
      }
    }
  },
  "typography": {
    "family": {
      "sans": {
        "$value": [
          "Inter",
          "Inter-fallback",
          "Segoe UI",
          "Roboto",
          "system-ui",
          "sans-serif"
        ],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "Cascadia Code",
          "Fira Code",
          "Consolas",
          "monospace"
        ],
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": {
        "$value": { "value": 0.64, "unit": "rem" },
        "$type": "dimension"
      },
      "sm": {
        "$value": { "value": 0.78, "unit": "rem" },
        "$type": "dimension"
      },
      "base": {
        "$value": { "value": 0.94, "unit": "rem" },
        "$type": "dimension"
      },
      "md": {
        "$value": { "value": 1.13, "unit": "rem" },
        "$type": "dimension"
      },
      "lg": {
        "$value": { "value": 1.35, "unit": "rem" },
        "$type": "dimension"
      },
      "xl": {
        "$value": { "value": 1.62, "unit": "rem" },
        "$type": "dimension"
      },
      "2xl": {
        "$value": { "value": 1.94, "unit": "rem" },
        "$type": "dimension"
      },
      "3xl": {
        "$value": { "value": 2.33, "unit": "rem" },
        "$type": "dimension"
      }
    },
    "weight": {
      "normal": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "black": { "$value": 800, "$type": "fontWeight" }
    },
    "line-height": {
      "tight": { "$value": 1.2, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" },
      "loose": { "$value": 1.7, "$type": "number" }
    },
    "letter-spacing": {
      "tight": {
        "$value": { "value": -0.02, "unit": "em" },
        "$type": "dimension"
      },
      "normal": {
        "$value": { "value": 0, "unit": "em" },
        "$type": "dimension"
      },
      "wide": {
        "$value": { "value": 0.04, "unit": "em" },
        "$type": "dimension"
      }
    }
  },
  "spacing": {
    "1": { "$value": { "value": 0.25, "unit": "rem" }, "$type": "dimension" },
    "2": { "$value": { "value": 0.5, "unit": "rem" }, "$type": "dimension" },
    "3": { "$value": { "value": 0.75, "unit": "rem" }, "$type": "dimension" },
    "4": { "$value": { "value": 1, "unit": "rem" }, "$type": "dimension" },
    "6": { "$value": { "value": 1.5, "unit": "rem" }, "$type": "dimension" },
    "8": { "$value": { "value": 2, "unit": "rem" }, "$type": "dimension" },
    "12": { "$value": { "value": 3, "unit": "rem" }, "$type": "dimension" },
    "16": { "$value": { "value": 4, "unit": "rem" }, "$type": "dimension" },
    "20": { "$value": { "value": 5, "unit": "rem" }, "$type": "dimension" },
    "24": { "$value": { "value": 6, "unit": "rem" }, "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": { "value": 0, "unit": "px" }, "$type": "dimension" },
    "sm": { "$value": { "value": 6, "unit": "px" }, "$type": "dimension" },
    "md": { "$value": { "value": 10, "unit": "px" }, "$type": "dimension" },
    "lg": { "$value": { "value": 16, "unit": "px" }, "$type": "dimension" },
    "xl": { "$value": { "value": 24, "unit": "px" }, "$type": "dimension" },
    "full": { "$value": { "value": 9999, "unit": "px" }, "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "instant": {
        "$value": { "value": 0, "unit": "ms" },
        "$type": "duration"
      },
      "fast": { "$value": { "value": 120, "unit": "ms" }, "$type": "duration" },
      "normal": {
        "$value": { "value": 220, "unit": "ms" },
        "$type": "duration"
      },
      "slow": { "$value": { "value": 350, "unit": "ms" }, "$type": "duration" },
      "glacial": {
        "$value": { "value": 600, "unit": "ms" },
        "$type": "duration"
      }
    },
    "easing": {
      "out": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier" },
      "in-out": { "$value": [0.65, 0, 0.35, 1], "$type": "cubicBezier" },
      "spring": { "$value": [0.34, 1.56, 0.64, 1], "$type": "cubicBezier" }
    }
  },
  "shadow": {
    "color": {
      "$value": { "colorSpace": "srgb", "components": [0.059, 0.051, 0.043] },
      "$type": "color"
    },
    "xs": {
      "$value": {
        "offsetX": 0,
        "offsetY": 1,
        "blur": 3,
        "color": "rgba(var(--shadow-color), 0.04)"
      },
      "$type": "shadow"
    },
    "sm": {
      "$value": {
        "offsetX": 0,
        "offsetY": 4,
        "blur": 12,
        "color": "rgba(var(--shadow-color), 0.06)"
      },
      "$type": "shadow"
    },
    "md": {
      "$value": {
        "offsetX": 0,
        "offsetY": 12,
        "blur": 40,
        "color": "rgba(var(--shadow-color), 0.08)"
      },
      "$type": "shadow"
    },
    "card": {
      "$value": {
        "offsetX": 0,
        "offsetY": 8,
        "blur": 24,
        "color": "rgba(var(--shadow-color), 0.06)"
      },
      "$type": "shadow"
    }
  }
}
