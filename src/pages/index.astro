---
import HeroSection from "../components/HeroSection.astro";

import Layout from "../layouts/Layout.astro";
import heroPhoto from "../assets/brand/ahmed-photo-hero.webp";
import SponsorSection from "../components/SponsorSection.astro";
import ContactSection from "../components/ContactSection.astro";
import ResumeSection from "../components/ResumeSection.astro";
import ProfileSection from "../components/ProfileSection.astro";
import CapabilitiesSection from "../components/CapabilitiesSection.astro";
import ProofSection from "../components/ProofSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import UpworkSection from "../components/UpworkSection.astro";
import FeedSection from "../components/FeedSection.astro";
import AdditionalProjectsSection from "../components/AdditionalProjectsSection.astro";
import CaseStudiesSection from "../components/CaseStudiesSection.astro";
import FeaturedProjectsSection from "../components/FeaturedProjectsSection.astro";
import LabSection from "../components/LabSection.astro";
import ServicesSection from "../components/ServicesSection.astro";

import {
  contactEmail,
  upworkProfileUrl,
  upworkPortfolioItems,
  upworkPortfolioCount,
  upworkPortfolioCountLabel,
  recentUpworkProofTitles,
  profileLinks,
  badges,
  proofStackMetrics,
  proofCategories,
  servicesOfferings,
  testimonials,
  caseStudies,
  featuredProjects,
  additionalProjects,
  writingLinks,
  feedSources,
  labNotes,
  contactWidgets,
  resumeWidgets,
  profileWidgets,
  upworkProofCards,
  upworkFitTags,
  capabilities,
  credibilityFacts,
  ventureProof,
  certificationLinks,
  openSourceFreemium,
  sponsorLinks,
} from "../data/site-content";
---

<Layout>
<main class="site-wrap" id="main-content">
  <header class="top-bar">
    <div class="wordmark" aria-label="Ahmed Rehan — ARLabs">
      <span class="wm-mono" aria-hidden="true">AR</span>
      <div class="wm-text">
        <span class="wm-name">Ahmed Rehan</span>
        <span class="wm-studio"
          >ARLabs <span
            class="wm-avail"
            title="Available for work"
            role="img"
            aria-label="Available for work">●</span
          ></span
        >
      </div>
    </div>
    <nav class="anchor-rail" aria-label="Page sections">
      <a href="#lab-title" data-spy="lab-title">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><polyline points="4 17 10 11 4 5"></polyline><line
            x1="12"
            y1="19"
            x2="20"
            y2="19"></line></svg
        >
        Lab
      </a>
      <a href="#projects-title" data-spy="projects-title">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="7" width="20" height="14" rx="2"></rect><path
            d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"></path></svg
        >
        Work
      </a>
      <a href="#upwork-title" data-spy="upwork-title">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><polyline points="17 7 7 17"></polyline><polyline
            points="7 7 17 7 17 17"></polyline></svg
        >
        Upwork
      </a>
      <a href="#proof-title" data-spy="proof-title">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
          ></path><polyline points="9 12 11 14 15 10"></polyline></svg
        >
        Proof
      </a>
      <a href="#contact-title" data-spy="contact-title">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path
            d="M2 7l10 7 10-7"></path></svg
        >
        Contact
      </a>
      <a
        href="https://products.ar27111994.dev/"
        target="_blank"
        rel="noreferrer"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"
          ></path><polyline points="15 3 21 3 21 9"></polyline><line
            x1="10"
            y1="14"
            x2="21"
            y2="3"></line></svg
        >
        Products
      </a>
      <a href="/privacy">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
            d="M7 11V7a5 5 0 0110 0v4"></path></svg
        >
        Privacy
      </a>
    </nav>
  </header>

  <HeroSection
    heroPhoto={heroPhoto}
    badges={badges}
    proofStackMetrics={proofStackMetrics}
    proofCategories={proofCategories}
    credibilityFacts={credibilityFacts}
    recentUpworkProofTitles={recentUpworkProofTitles}
  />
  <ServicesSection servicesOfferings={servicesOfferings} />

  <LabSection labNotes={labNotes} />

  <FeaturedProjectsSection featuredProjects={featuredProjects} />

  <CaseStudiesSection caseStudies={caseStudies} />

  <AdditionalProjectsSection
    additionalProjects={additionalProjects}
    writingLinks={writingLinks}
  />

  <FeedSection feedSources={feedSources} writingLinks={writingLinks} />

  <UpworkSection
    upworkPortfolioItems={upworkPortfolioItems}
    upworkPortfolioCountLabel={upworkPortfolioCountLabel}
    recentUpworkProofTitles={recentUpworkProofTitles}
    upworkFitTags={upworkFitTags}
    upworkProfileUrl={upworkProfileUrl}
    upworkPortfolioCount={upworkPortfolioCount}
    upworkProofCards={upworkProofCards}
  />

  <TestimonialsSection testimonials={testimonials} />

  <ProofSection
    contactEmail={contactEmail}
    certificationLinks={certificationLinks}
    ventureProof={ventureProof}
    openSourceFreemium={openSourceFreemium}
  />

  <CapabilitiesSection capabilities={capabilities} />

  <ProfileSection profileWidgets={profileWidgets} profileLinks={profileLinks} />

  <ResumeSection resumeWidgets={resumeWidgets} />

  <ContactSection contactEmail={contactEmail} contactWidgets={contactWidgets} />

  <SponsorSection contactEmail={contactEmail} sponsorLinks={sponsorLinks} />
  <footer class="site-footer" role="contentinfo">
    <p>© {new Date().getFullYear()} Ahmed Rehan · ARLabs</p>
    <p>
      <a href="/privacy">Privacy Policy</a> · <a
        href="mailto:admin@ar27111994.dev">admin@ar27111994.dev</a
      >
    </p>
  </footer>
</main>
</Layout>

<script src="/scripts/page-init.js" defer></script>
